{
  "name": "Conversation",
  "description": "An AI Study Buddy conversation thread, private to its owner.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string"
    },
    "message_count": {
      "type": "number"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}